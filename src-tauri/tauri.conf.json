{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "游戏扫码器",
  "version": "0.3.0",
  "identifier": "com.taumata.game-scanner",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "游戏扫码器",
        "width": 300,
        "height": 500,
        "resizable": false,
        "decorations": false,
        "backgroundColor": "#1e1e1e",
        "shadow": false,
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
